---
import NowLog from './NowLog.astro';
---
<!-- ════════════════════ ABOUT ═════════════════════════ -->
<section id="about">
  <div class="container">
    <div class="about-grid">
      <!-- LEFT -->
      <div class="about-left gsap-reveal">
        <span class="s-label"><i class="fa-solid fa-user" aria-hidden="true"></i> About Me</span>
        <h2 class="s-title glitch" data-text="Driven by Curiosity, Guided by Purpose">Driven by Curiosity,<br>Guided by Purpose</h2>

        <div class="float-badges">
          <span class="float-badge"><i class="fa-brands fa-python" aria-hidden="true"></i> Python</span>
          <span class="float-badge"><i class="fa-solid fa-code" aria-hidden="true"></i> Web Development</span>
          <span class="float-badge"><i class="fa-solid fa-bug" aria-hidden="true"></i> QA Testing</span>
          <span class="float-badge"><i class="fa-solid fa-database" aria-hidden="true"></i> MySQL · SQL Server</span>
        </div>

        <div class="about-highlights" style="margin-top:24px;">
          <div class="about-item"><div class="about-icon"><i class="fa-solid fa-laptop-code" aria-hidden="true"></i></div><span class="about-item-text">Software Development</span></div>
          <div class="about-item"><div class="about-icon"><i class="fa-solid fa-bug" aria-hidden="true"></i></div><span class="about-item-text">Testing &amp; QA</span></div>
          <div class="about-item"><div class="about-icon"><i class="fa-solid fa-wrench" aria-hidden="true"></i></div><span class="about-item-text">Technical Troubleshooting</span></div>
          <div class="about-item"><div class="about-icon"><i class="fa-solid fa-book-open" aria-hidden="true"></i></div><span class="about-item-text">Continuous Learning</span></div>
          <div class="about-item"><div class="about-icon"><i class="fa-solid fa-network-wired" aria-hidden="true"></i></div><span class="about-item-text">Networking (capstone)</span></div>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="about-right gsap-reveal">
        <p id="aboutIntro">I'm Renso, a fourth-year Information Technology student at De La Salle Lipa, building a career in tech. I'm most interested in software development, web development and quality assurance, and my capstone also gave me hands-on networking experience.</p>
        <!-- portfolioData.about.story renders here (Feature 41) only when it is filled in -->
        <p>I keep up with new technology and keep improving my skills through coursework, certificate programs and self-directed learning. I value clear communication, analytical thinking and putting what I learn into practice.</p>
        <p>My goal is to grow as a software developer or QA tester, combining strong fundamentals with a growth mindset.</p>
        <div class="about-card">
          <p class="about-card-title"><i class="fa-solid fa-bolt" style="color:var(--accent-on-dark);margin-right:7px" aria-hidden="true"></i>Key Interests</p>
          <div class="about-card-grid">
            <div class="aci"><i class="fa-solid fa-check-circle" aria-hidden="true"></i> Software Development</div>
            <div class="aci"><i class="fa-solid fa-check-circle" aria-hidden="true"></i> Web Development</div>
            <div class="aci"><i class="fa-solid fa-check-circle" aria-hidden="true"></i> Quality Assurance</div>
            <div class="aci"><i class="fa-solid fa-check-circle" aria-hidden="true"></i> Python Programming</div>
            <div class="aci"><i class="fa-solid fa-check-circle" aria-hidden="true"></i> Databases</div>
            <div class="aci"><i class="fa-solid fa-check-circle" aria-hidden="true"></i> Networking</div>
          </div>
        </div>
        <NowLog />
      </div>
    </div>
  </div>
</section>
